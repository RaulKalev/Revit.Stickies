<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stickies.Core: data model and persistence. Deliberately free of any Revit API reference so it can be unit
    tested and reused by both Revit targets. Its sources are also compiled into Stickies.dll (see that project).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Stickies.Core</AssemblyName>
    <RootNamespace>Stickies.Core</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.2.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Stickies.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
