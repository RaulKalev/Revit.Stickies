<UserControl
    x:Class="Stickies.UI.MarkupPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Stickies.UI"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:vm="clr-namespace:Stickies.UI.ViewModels"
    MinWidth="280"
    Background="{DynamicResource Window.Background}"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True">
    <!--  Content of the Stickies dockable pane. Revit draws the pane frame; this is everything inside it.  -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Palette + materials are inserted at runtime by ThemeManager; styles use DynamicResource  -->
                <ResourceDictionary Source="pack://application:,,,/Stickies;component/UI/Themes/DarkTheme.xaml" />
                <local:SharedDictionary Source="pack://application:,,,/Stickies;component/UI/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:ValueEqualsConverter x:Key="Equals" />

            <!--  Centred message (empty and setup states)  -->
            <Style x:Key="PaneMessage" TargetType="{x:Type StackPanel}">
                <Setter Property="Margin" Value="24" />
                <Setter Property="MaxWidth" Value="300" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="PaneMessageIcon" TargetType="{x:Type materialDesign:PackIcon}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
            </Style>
            <Style
                x:Key="PaneMessageTitle"
                BasedOn="{StaticResource Type.Section}"
                TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="0,12,0,4" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style
                x:Key="PaneMessageText"
                BasedOn="{StaticResource Type.Secondary}"
                TargetType="{x:Type TextBlock}">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!--  Issue status glyph (binds to Status): shape + colour, always next to a word or tooltip  -->
            <Style x:Key="IssueStatusIcon" TargetType="{x:Type materialDesign:PackIcon}">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Kind" Value="CircleOutline" />
                <Setter Property="Foreground" Value="{DynamicResource Status.Info}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="InProgress">
                        <Setter Property="Kind" Value="ProgressClock" />
                        <Setter Property="Foreground" Value="{DynamicResource Status.Warning}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Resolved">
                        <Setter Property="Kind" Value="CheckCircleOutline" />
                        <Setter Property="Foreground" Value="{DynamicResource Status.Ok}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Closed">
                        <Setter Property="Kind" Value="CheckCircle" />
                        <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FieldLabel" BasedOn="{StaticResource Type.Label}" TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="0,12,0,4" />
            </Style>

            <!--  ============ One issue row ============  -->
            <DataTemplate x:Key="IssueRow" DataType="{x:Type vm:IssueRowViewModel}">
                <Grid Background="Transparent" ToolTip="{Binding ToolTip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon
                        Margin="0,1,0,0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{Binding StatusText}"
                        Style="{StaticResource IssueStatusIcon}" />
                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <materialDesign:PackIcon
                                Width="14"
                                Height="14"
                                Margin="6,1,0,0"
                                VerticalAlignment="Top"
                                DockPanel.Dock="Right"
                                Foreground="{DynamicResource Status.Error}"
                                Kind="ChevronDoubleUp"
                                ToolTip="High priority"
                                Visibility="{Binding IsHighPriority, Converter={StaticResource BoolToVis}}" />
                            <materialDesign:PackIcon
                                Width="14"
                                Height="14"
                                Margin="6,1,0,0"
                                VerticalAlignment="Top"
                                DockPanel.Dock="Right"
                                Foreground="{DynamicResource Text.Tertiary}"
                                Kind="ChevronDown"
                                ToolTip="Low priority"
                                Visibility="{Binding IsLowPriority, Converter={StaticResource BoolToVis}}" />
                            <TextBlock
                                Margin="0,0,6,0"
                                DockPanel.Dock="Left"
                                Foreground="{DynamicResource Text.Tertiary}"
                                Text="{Binding NumberText}"
                                ToolTip="The number on the marker in views"
                                Visibility="{Binding NumberText, Converter={StaticResource NotEmptyToVis}}" />
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                        <WrapPanel Margin="0,2,0,0">
                            <TextBlock
                                Margin="0,0,10,0"
                                Style="{StaticResource Type.Caption}"
                                Text="{Binding Meta}" />
                            <StackPanel
                                Margin="0,0,10,0"
                                Orientation="Horizontal"
                                Visibility="{Binding HasComments, Converter={StaticResource BoolToVis}}">
                                <materialDesign:PackIcon
                                    Width="12"
                                    Height="12"
                                    Margin="0,1,3,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Text.Tertiary}"
                                    Kind="CommentOutline" />
                                <TextBlock Style="{StaticResource Type.Caption}" Text="{Binding CommentCount}" />
                            </StackPanel>
                            <Border Style="{StaticResource Badge.Warning}" Visibility="{Binding HasTargetProblem, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding TargetText}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        Background="{DynamicResource Window.Background}"
        TextElement.FontFamily="{StaticResource Font.Text}"
        TextElement.FontSize="{StaticResource FontSize.Body}"
        TextElement.Foreground="{DynamicResource Text.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header: title, marker visibility, appearance toggle  -->
        <Border
            Background="{DynamicResource Toolbar.Material}"
            BorderBrush="{DynamicResource Separator}"
            BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0,10,0">
                <Button
                    x:Name="ThemeButton"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Switch between dark and light appearance"
                    Click="ToggleTheme_Click"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Switch between dark and light appearance">
                    <materialDesign:PackIcon
                        x:Name="ThemeIcon"
                        Width="16"
                        Height="16"
                        Kind="WeatherNight" />
                </Button>
                <ToggleButton
                    x:Name="CardsButton"
                    Margin="0,0,2,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Show issues as sticky-note cards"
                    Click="ToggleCards_Click"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Button.Icon}">
                    <materialDesign:PackIcon
                        x:Name="CardsIcon"
                        Width="16"
                        Height="16"
                        Kind="NoteOutline" />
                </ToggleButton>
                <ToggleButton
                    x:Name="MarkersButton"
                    Margin="0,0,2,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Show markers on views"
                    Click="ToggleMarkers_Click"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Button.Icon}">
                    <materialDesign:PackIcon
                        x:Name="MarkersIcon"
                        Width="16"
                        Height="16"
                        Kind="EyeOutline" />
                </ToggleButton>
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="Stickies" />
            </DockPanel>
        </Border>

        <!--  Body: one block per session state  -->
        <Grid Grid.Row="1">
            <!--  No project open / family document  -->
            <StackPanel Style="{StaticResource PaneMessage}" Visibility="{Binding Session.IsNoModel, Converter={StaticResource BoolToVis}}">
                <materialDesign:PackIcon Kind="FileOutline" Style="{StaticResource PaneMessageIcon}" />
                <TextBlock Style="{StaticResource PaneMessageTitle}" Text="No project open" />
                <TextBlock Style="{StaticResource PaneMessageText}" Text="Open a project to see its review issues." />
            </StackPanel>
            <StackPanel Style="{StaticResource PaneMessage}" Visibility="{Binding Session.IsFamily, Converter={StaticResource BoolToVis}}">
                <materialDesign:PackIcon Kind="FileOutline" Style="{StaticResource PaneMessageIcon}" />
                <TextBlock Style="{StaticResource PaneMessageTitle}" Text="Family document" />
                <TextBlock Style="{StaticResource PaneMessageText}" Text="Review issues belong to project models. Switch to a project to see them." />
            </StackPanel>

            <!--  No markup folder yet: asked once, then remembered  -->
            <StackPanel Style="{StaticResource PaneMessage}" Visibility="{Binding Session.NeedsFolder, Converter={StaticResource BoolToVis}}">
                <materialDesign:PackIcon Kind="FolderOutline" Style="{StaticResource PaneMessageIcon}" />
                <TextBlock Style="{StaticResource PaneMessageTitle}" Text="Where should issues be kept?" />
                <TextBlock Style="{StaticResource PaneMessageText}" Text="Issues are shared as files in a _markup folder inside the project's Dropbox folder." />
                <StackPanel Visibility="{Binding Session.CanCreateNextToModel, Converter={StaticResource BoolToVis}}">
                    <Button
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Click="CreateNextToModel_Click"
                        Content="Create next to the model"
                        Style="{StaticResource Button.Primary}"
                        ToolTip="{Binding Session.ProposedFolder}" />
                    <TextBlock
                        MaxWidth="260"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource Type.Caption}"
                        Text="{Binding Session.ProposedFolder}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock
                    Margin="0,12,0,0"
                    Style="{StaticResource PaneMessageText}"
                    Text="This model is not saved in a folder (unsaved, cloud or server model). Choose the project's shared folder."
                    Visibility="{Binding Session.CanCreateNextToModel, Converter={StaticResource InverseBoolToVis}}" />
                <Button
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Click="ChooseFolder_Click"
                    Content="Choose folder…"
                    Style="{StaticResource Button.Secondary}"
                    ToolTip="Pick the project's shared folder (or an existing _markup folder)" />
            </StackPanel>

            <!--  Error  -->
            <StackPanel Style="{StaticResource PaneMessage}" Visibility="{Binding Session.HasError, Converter={StaticResource BoolToVis}}">
                <materialDesign:PackIcon
                    Foreground="{DynamicResource Status.Error}"
                    Kind="AlertCircleOutline"
                    Style="{StaticResource PaneMessageIcon}" />
                <TextBlock Style="{StaticResource PaneMessageTitle}" Text="Markup is not available" />
                <TextBlock Style="{StaticResource PaneMessageText}" Text="{Binding Session.ErrorMessage}" />
                <Button
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    Click="ChooseFolder_Click"
                    Content="Choose folder…"
                    Style="{StaticResource Button.Secondary}" />
            </StackPanel>

            <!--  ============ Connected: the issue panel ============  -->
            <Grid x:Name="IssuePanel" Visibility="{Binding Session.IsConnected, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="ListRow" Height="*" MinHeight="80" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="EditorRow" Height="0" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Filter bar: search, filters popover, add  -->
                <DockPanel Margin="12,10,12,6">
                    <Button
                        Margin="6,0,0,0"
                        Padding="10,0"
                        AutomationProperties.Name="Add issue"
                        Command="{Binding AddIssueCommand}"
                        DockPanel.Dock="Right"
                        Style="{StaticResource Button.Primary}"
                        ToolTip="Add an issue in the active view: select an element first, or click the spot">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Style="{StaticResource ButtonIconLabel}" />
                            <TextBlock Text="Add" />
                        </StackPanel>
                    </Button>
                    <Grid Margin="6,0,0,0" DockPanel.Dock="Right">
                        <ToggleButton
                            x:Name="FiltersButton"
                            Width="{StaticResource Size.Control}"
                            Height="{StaticResource Size.Control}"
                            AutomationProperties.Name="Filters and sort"
                            IsHitTestVisible="{Binding IsOpen, ElementName=FiltersPopup, Converter={StaticResource Not}}"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="Filter by priority and people, and sort">
                            <Grid>
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="FilterVariant" />
                                <Ellipse
                                    Width="7"
                                    Height="7"
                                    Margin="0,-3,-5,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Fill="{DynamicResource Accent}"
                                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </ToggleButton>
                        <Popup
                            x:Name="FiltersPopup"
                            AllowsTransparency="True"
                            IsOpen="{Binding IsChecked, ElementName=FiltersButton}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=FiltersButton}"
                            PopupAnimation="Fade"
                            StaysOpen="False"
                            VerticalOffset="4">
                            <Border
                                Width="260"
                                Margin="0,0,14,14"
                                Padding="16,12,16,16"
                                Style="{StaticResource PopupSurface}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Type.Label}" Text="Priority" />
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <CheckBox
                                            Margin="0,0,14,0"
                                            Content="High"
                                            IsChecked="{Binding PriorityHigh}"
                                            Style="{StaticResource Input.Check}" />
                                        <CheckBox
                                            Margin="0,0,14,0"
                                            Content="Normal"
                                            IsChecked="{Binding PriorityNormal}"
                                            Style="{StaticResource Input.Check}" />
                                        <CheckBox
                                            Content="Low"
                                            IsChecked="{Binding PriorityLow}"
                                            Style="{StaticResource Input.Check}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Author" />
                                    <ComboBox
                                        AutomationProperties.Name="Author"
                                        DisplayMemberPath="Text"
                                        ItemsSource="{Binding PeopleChoices}"
                                        SelectedValue="{Binding Author}"
                                        SelectedValuePath="Value"
                                        Style="{StaticResource Input.Combo}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Assignee" />
                                    <ComboBox
                                        AutomationProperties.Name="Assignee"
                                        DisplayMemberPath="Text"
                                        ItemsSource="{Binding PeopleChoices}"
                                        SelectedValue="{Binding AssigneeFilter}"
                                        SelectedValuePath="Value"
                                        Style="{StaticResource Input.Combo}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Sort by" />
                                    <DockPanel>
                                        <Button
                                            Margin="6,0,0,0"
                                            AutomationProperties.Name="{Binding SortDirectionText}"
                                            Command="{Binding ToggleSortDirectionCommand}"
                                            DockPanel.Dock="Right"
                                            ToolTip="{Binding SortDirectionText}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource Button.Icon}" TargetType="{x:Type Button}">
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <materialDesign:PackIcon Width="16" Height="16" Kind="SortDescending" />
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SortDescending}" Value="False">
                                                            <Setter Property="Content">
                                                                <Setter.Value>
                                                                    <materialDesign:PackIcon Width="16" Height="16" Kind="SortAscending" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <ComboBox
                                            AutomationProperties.Name="Sort by"
                                            DisplayMemberPath="Text"
                                            ItemsSource="{Binding SortColumns}"
                                            SelectedValue="{Binding SortColumn}"
                                            SelectedValuePath="Value"
                                            Style="{StaticResource Input.Combo}" />
                                    </DockPanel>
                                    <Button
                                        Margin="0,14,0,0"
                                        HorizontalAlignment="Left"
                                        Padding="8,0"
                                        Command="{Binding ClearFiltersCommand}"
                                        Content="Clear filters and search"
                                        Style="{StaticResource Button.Plain}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <TextBox
                        x:Name="SearchBox"
                        AutomationProperties.Name="Search issues"
                        Style="{StaticResource Input.Text}"
                        Tag="Search issues"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                </DockPanel>

                <!--  Scope + count  -->
                <DockPanel Grid.Row="1" Margin="12,0,12,4">
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        Style="{StaticResource Type.Caption}"
                        Text="{Binding CountText}" />
                    <Border HorizontalAlignment="Left" Style="{StaticResource Segmented}">
                        <StackPanel AutomationProperties.Name="Show issues" Orientation="Horizontal">
                            <RadioButton Content="Active" GroupName="Scope" IsChecked="{Binding Scope, Converter={StaticResource Equals}, ConverterParameter=active}" Style="{StaticResource Segment}" ToolTip="Open and in progress" />
                            <RadioButton Content="Resolved" GroupName="Scope" IsChecked="{Binding Scope, Converter={StaticResource Equals}, ConverterParameter=resolved}" Style="{StaticResource Segment}" />
                            <RadioButton Content="Closed" GroupName="Scope" IsChecked="{Binding Scope, Converter={StaticResource Equals}, ConverterParameter=closed}" Style="{StaticResource Segment}" />
                            <RadioButton Content="All" GroupName="Scope" IsChecked="{Binding Scope, Converter={StaticResource Equals}, ConverterParameter=all}" Style="{StaticResource Segment}" />
                        </StackPanel>
                    </Border>
                </DockPanel>

                <!--  List  -->
                <Grid Grid.Row="2">
                    <ListBox
                        x:Name="IssueList"
                        AutomationProperties.Name="Issues"
                        ItemTemplate="{StaticResource IssueRow}"
                        ItemsSource="{Binding Rows}"
                        KeyDown="IssueList_KeyDown"
                        MouseDoubleClick="IssueList_MouseDoubleClick"
                        SelectedItem="{Binding Selected}"
                        Style="{StaticResource MasterList}"
                        VirtualizingPanel.IsVirtualizing="True"
                        Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Style="{StaticResource PaneMessage}" Visibility="{Binding ShowNoIssues, Converter={StaticResource BoolToVis}}">
                        <materialDesign:PackIcon Kind="CommentTextMultipleOutline" Style="{StaticResource PaneMessageIcon}" />
                        <TextBlock Style="{StaticResource PaneMessageTitle}" Text="No issues yet" />
                        <TextBlock Style="{StaticResource PaneMessageText}" Text="Open a view, then use Add to mark something for review." />
                    </StackPanel>
                    <StackPanel Style="{StaticResource PaneMessage}" Visibility="{Binding ShowNoMatches, Converter={StaticResource BoolToVis}}">
                        <materialDesign:PackIcon Kind="FilterVariantRemove" Style="{StaticResource PaneMessageIcon}" />
                        <TextBlock Style="{StaticResource PaneMessageTitle}" Text="No matching issues" />
                        <TextBlock Style="{StaticResource PaneMessageText}" Text="Nothing matches the search, status and filters." />
                        <Button
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            Command="{Binding ClearFiltersCommand}"
                            Content="Clear filters and search"
                            Style="{StaticResource Button.Secondary}" />
                    </StackPanel>
                </Grid>

                <GridSplitter
                    x:Name="EditorSplitter"
                    Grid.Row="3"
                    Height="6"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    BorderBrush="{DynamicResource Separator}"
                    BorderThickness="0,1,0,0"
                    Cursor="SizeNS"
                    Focusable="False"
                    ResizeBehavior="PreviousAndNext"
                    Visibility="{Binding HasEditor, Converter={StaticResource BoolToVis}}" />

                <!--  ============ Selected / new issue ============  -->
                <ScrollViewer
                    Grid.Row="4"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding HasEditor, Converter={StaticResource BoolToVis}}">
                    <StackPanel x:Name="EditorPanel" Margin="16,8,16,16" DataContext="{Binding Editor}">
                        <!--  Heading: status, open view, close  -->
                        <DockPanel>
                            <Button
                                AutomationProperties.Name="Close"
                                Command="{Binding DataContext.CloseEditorCommand, ElementName=IssuePanel}"
                                DockPanel.Dock="Right"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="Close"
                                Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVis}}">
                                <materialDesign:PackIcon Width="16" Height="16" Kind="Close" />
                            </Button>
                            <Button
                                Height="{StaticResource Size.ControlSmall}"
                                Margin="0,0,4,0"
                                Padding="8,0"
                                Command="{Binding OpenViewCommand}"
                                DockPanel.Dock="Right"
                                Style="{StaticResource Button.Plain}"
                                ToolTip="Open the view as it was when the issue was added (also: double-click the issue)"
                                Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="OpenInNew" Style="{StaticResource ButtonIconLabel}" />
                                    <TextBlock Text="Open view" />
                                </StackPanel>
                            </Button>
                            <materialDesign:PackIcon
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource IssueStatusIcon}"
                                Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVis}}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource Type.Section}"
                                Text="{Binding Heading}" />
                        </DockPanel>

                        <!--  Banner: conflict, error or notice  -->
                        <Border
                            Margin="0,10,0,0"
                            Padding="10,8"
                            CornerRadius="{StaticResource Radius.Control}"
                            Visibility="{Binding Banner, Converter={StaticResource NotEmptyToVis}}">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="{DynamicResource Status.Info.Subtle}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BannerIsError}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Status.Warning.Subtle}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock
                                    Style="{StaticResource Type.Secondary}"
                                    Foreground="{DynamicResource Text.Primary}"
                                    Text="{Binding Banner}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ReloadCommand}"
                                    Content="Reload"
                                    Style="{StaticResource Button.Secondary}"
                                    Visibility="{Binding HasConflict, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                        <StackPanel
                            Margin="0,10,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding TargetText, Converter={StaticResource NotEmptyToVis}}">
                            <materialDesign:PackIcon
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Status.Warning}"
                                Kind="AlertOutline" />
                            <TextBlock Style="{StaticResource Type.Secondary}" Text="{Binding TargetText}" />
                        </StackPanel>

                        <!--  Fields  -->
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Title" />
                        <TextBox
                            x:Name="TitleBox"
                            AutomationProperties.Name="Title"
                            Style="{StaticResource Input.Text}"
                            Tag="What needs attention?"
                            Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Details" />
                        <TextBox
                            AutomationProperties.Name="Details"
                            MaxHeight="160"
                            Style="{StaticResource Input.MultiLine}"
                            Tag="Optional"
                            Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                            VerticalScrollBarVisibility="Auto" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Priority" />
                        <Border HorizontalAlignment="Left" Style="{StaticResource Segmented}">
                            <StackPanel AutomationProperties.Name="Priority" Orientation="Horizontal">
                                <RadioButton Content="Low" IsChecked="{Binding IsLow}" Style="{StaticResource Segment}" />
                                <RadioButton Content="Normal" IsChecked="{Binding IsNormal}" Style="{StaticResource Segment}" />
                                <RadioButton Content="High" IsChecked="{Binding IsHigh}" Style="{StaticResource Segment}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Assignee" />
                        <DockPanel>
                            <Grid Margin="6,0,0,0" DockPanel.Dock="Right">
                                <ToggleButton
                                    x:Name="PeopleButton"
                                    Width="{StaticResource Size.Control}"
                                    Height="{StaticResource Size.Control}"
                                    AutomationProperties.Name="Pick a person"
                                    IsHitTestVisible="{Binding IsOpen, ElementName=PeoplePopup, Converter={StaticResource Not}}"
                                    Style="{StaticResource Button.Icon}"
                                    ToolTip="Pick someone who has worked on this project's issues">
                                    <materialDesign:PackIcon Width="16" Height="16" Kind="AccountSearchOutline" />
                                </ToggleButton>
                                <Popup
                                    x:Name="PeoplePopup"
                                    AllowsTransparency="True"
                                    IsOpen="{Binding IsChecked, ElementName=PeopleButton}"
                                    Placement="Bottom"
                                    PlacementTarget="{Binding ElementName=PeopleButton}"
                                    PopupAnimation="Fade"
                                    StaysOpen="False"
                                    VerticalOffset="4">
                                    <Border
                                        Width="200"
                                        Margin="0,0,14,14"
                                        Padding="4"
                                        Style="{StaticResource PopupSurface}">
                                        <ListBox
                                            x:Name="PeopleList"
                                            MaxHeight="220"
                                            AutomationProperties.Name="People"
                                            ItemsSource="{Binding DataContext.People, ElementName=IssuePanel}"
                                            PreviewMouseLeftButtonUp="PeopleList_Pick"
                                            Style="{StaticResource MasterList}" />
                                    </Border>
                                </Popup>
                            </Grid>
                            <TextBox
                                AutomationProperties.Name="Assignee"
                                Style="{StaticResource Input.Text}"
                                Tag="Unassigned (Windows user name)"
                                Text="{Binding Assignee, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <!--  Save / undo (only with unsaved changes)  -->
                        <StackPanel
                            Margin="0,14,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Visibility="{Binding ShowSaveBar, Converter={StaticResource BoolToVis}}">
                            <Button
                                Margin="0,0,8,0"
                                Command="{Binding RevertCommand}"
                                Content="{Binding RevertText}"
                                Style="{StaticResource Button.Secondary}" />
                            <Button
                                Command="{Binding SaveCommand}"
                                Content="{Binding SaveText}"
                                IsDefault="True"
                                Style="{StaticResource Button.Primary}" />
                        </StackPanel>

                        <!--  Existing issue: status, history, comments  -->
                        <StackPanel Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Status" />
                            <ItemsControl ItemsSource="{Binding StatusActions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StatusActionViewModel}">
                                        <Button
                                            Margin="0,0,8,6"
                                            Command="{Binding Command}"
                                            CommandParameter="{Binding Status}"
                                            Content="{Binding Text}"
                                            Style="{StaticResource Button.Secondary}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock
                                Style="{StaticResource Type.Caption}"
                                Text="{Binding CloseHint}"
                                TextWrapping="Wrap"
                                Visibility="{Binding CloseHint, Converter={StaticResource NotEmptyToVis}}" />

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock
                                    Style="{StaticResource Type.Caption}"
                                    Text="{Binding CreatedText}"
                                    ToolTip="{Binding CreatedExact}" />
                                <TextBlock
                                    Style="{StaticResource Type.Caption}"
                                    Text="{Binding ResolvedText}"
                                    Visibility="{Binding ResolvedText, Converter={StaticResource NotEmptyToVis}}" />
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="12"
                                        Height="12"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource Text.Tertiary}"
                                        Kind="EyeOutline" />
                                    <TextBlock Style="{StaticResource Type.Caption}" Text="{Binding ViewText}" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,2,0,0"
                                    Orientation="Horizontal"
                                    Visibility="{Binding ElementText, Converter={StaticResource NotEmptyToVis}}">
                                    <materialDesign:PackIcon
                                        Width="12"
                                        Height="12"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource Text.Tertiary}"
                                        Kind="CubeOutline" />
                                    <TextBlock Style="{StaticResource Type.Caption}" Text="{Binding ElementText}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Margin="0,18,0,6" Style="{StaticResource Type.Label}" Text="Comments" />
                            <ItemsControl ItemsSource="{Binding Comments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CommentViewModel}">
                                        <StackPanel Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Author}" />
                                                <TextBlock
                                                    Margin="6,1,0,0"
                                                    Style="{StaticResource Type.Caption}"
                                                    Text="{Binding When}"
                                                    ToolTip="{Binding Exact}" />
                                            </StackPanel>
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                Text="{Binding Text}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox
                                AutomationProperties.Name="New comment"
                                MinHeight="48"
                                MaxHeight="120"
                                Style="{StaticResource Input.MultiLine}"
                                Tag="Add a comment"
                                Text="{Binding NewComment, UpdateSourceTrigger=PropertyChanged}"
                                VerticalScrollBarVisibility="Auto" />
                            <Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Right"
                                Command="{Binding AddCommentCommand}"
                                Content="Comment"
                                Style="{StaticResource Button.Secondary}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!--  Feedback: what just happened  -->
                <DockPanel
                    Grid.Row="5"
                    Margin="16,4,12,4"
                    AutomationProperties.LiveSetting="Polite"
                    Visibility="{Binding Feedback, Converter={StaticResource NotEmptyToVis}}">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        Margin="0,0,6,0"
                        VerticalAlignment="Top"
                        Foreground="{DynamicResource Text.Secondary}"
                        Kind="InformationOutline" />
                    <TextBlock
                        Style="{StaticResource Type.Secondary}"
                        Text="{Binding Feedback}"
                        TextWrapping="Wrap" />
                </DockPanel>

                <!--  Folder  -->
                <Border
                    Grid.Row="6"
                    Padding="16,6,10,6"
                    BorderBrush="{DynamicResource Separator}"
                    BorderThickness="0,1,0,0">
                    <DockPanel>
                        <Button
                            Padding="8,0"
                            Click="ChooseFolder_Click"
                            Content="Change…"
                            DockPanel.Dock="Right"
                            Style="{StaticResource Button.Plain}"
                            ToolTip="Use another markup folder for this model" />
                        <materialDesign:PackIcon
                            Width="14"
                            Height="14"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Text.Tertiary}"
                            Kind="FolderOutline" />
                        <StackPanel
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            ToolTip="{Binding Session.SkippedDetails}"
                            Visibility="{Binding Session.SkippedSummary, Converter={StaticResource NotEmptyToVis}}">
                            <materialDesign:PackIcon
                                Width="14"
                                Height="14"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding Session.SkippedSummary}"
                                Foreground="{DynamicResource Status.Warning}"
                                Kind="AlertOutline" />
                        </StackPanel>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource Type.Caption}"
                            Text="{Binding Session.FolderPath}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTip="{Binding Session.FolderPath}" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
